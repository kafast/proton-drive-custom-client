# Desktop: daemon as a systemd user service.
# Installation: copy to ~/.config/systemd/user/protonsyncd.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now protonsyncd
[Unit]
Description=protonsync – inoffizieller Proton-Drive-Client (Daemon)
Documentation=https://github.com/kafast/proton-drive-custom-client
After=network-online.target graphical-session.target

[Service]
Type=exec
ExecStart=%h/.cargo/bin/protonsyncd
Restart=on-failure
RestartSec=10
# Socket at $XDG_RUNTIME_DIR/protonsync/daemon.sock, data under ~/.local/share/protonsync.
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
